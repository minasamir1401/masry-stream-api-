# MasryStream Backend Environment Configuration

# Application
PROJECT_NAME="MasryStream - منصة ديزني والمحتوى المصري"
VERSION="1.0.0"
DEBUG=true
API_PREFIX="/api"

# Database (PostgreSQL for production; automatic SQLite fallback available locally)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/masry_stream
SQLITE_FALLBACK=true
SQLITE_URL=sqlite+aiosqlite:///./data/masry_stream.db

# Telegram MTProto Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION_STRING=
TELEGRAM_SESSION_NAME=masry_stream_session
TELEGRAM_AUTO_JOIN_SOURCES=false
ADMIN_PASSWORD=
ADMIN_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ADMIN_SECURE_COOKIE=false

# Target Telegram Channels (Comma separated in env or list)
TELEGRAM_CHANNELS=["DisneyMasry"]

# Ingestion & Scraping Engine
SCRAPE_INTERVAL_MINUTES=60
SCRAPE_BATCH_LIMIT=100
AUTO_SCRAPE_ON_STARTUP=true

# Cache & Storage Directories
CACHE_DIR=./cache
POSTER_CACHE_DIR=./cache/posters
DATA_DIR=./data
STREAM_CHUNK_SIZE=1048576

# CORS
CORS_ORIGINS=["*"]

