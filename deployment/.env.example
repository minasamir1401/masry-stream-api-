# ==============================================================================
# MasryStream - Production & Dokploy Environment Configuration
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=masry_stream
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_own_strong_password
POSTGRES_PORT=5432

# Backend FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
API_PREFIX=/api
SQLITE_FALLBACK=false

# Admin Security & Auth
ADMIN_PASSWORD=change_this_to_strong_admin_password
ADMIN_ORIGINS=["https://animeclover.click","http://localhost:3000","http://127.0.0.1:3000"]
ADMIN_SECURE_COOKIE=true

# Telegram MTProto API Credentials (optional, from https://my.telegram.org)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION_STRING=
TELEGRAM_SESSION_NAME=masry_stream_session
TELEGRAM_AUTO_JOIN_SOURCES=false

# Target Channels & Scraper Settings
TELEGRAM_CHANNELS=["DisneyMasry"]
SCRAPE_INTERVAL_MINUTES=60
SCRAPE_BATCH_LIMIT=100
AUTO_SCRAPE_ON_STARTUP=true

# Frontend Next.js Configuration
FRONTEND_PORT=3000
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_SITE_URL=https://animeclover.click
NEXT_PUBLIC_API_URL=
INTERNAL_BACKEND_URL=http://backend:8000

# Optional 32+ character private key; blank generates a persistent key in DATA_DIR.
SECURITY_SIGNING_KEY=
